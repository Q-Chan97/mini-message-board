<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="page-container">
        <header class="header-container">
            <h1>What's Your Message?</h1>
            <h2>Share it with the world</h2>
        </header>
        <article class="form-content-container">
            <form class="form-container" method="POST" action="/new" >
                <div class="input-container">
                    <label for="name" title="name">Name:</label>
                    <input type="text" name="name" id="name" maxlength="18" placeholder="Name (Max 18 characters)">
                </div>
                <div class="input-container">
                    <label for="message" title="message">Message:</label>
                    <textarea type="text" name="message" id="message" placeholder="Write your message here..."></textarea>
                </div>
                <div class="buttons-container">
                    <a class="cancel-button" href="/">Cancel</a>
                    <button class="submit-button" type="submit">Submit</button>
                </div>
            </form>
        </article>
    </div>
</body>
</html>